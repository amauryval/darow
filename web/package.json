{
    "name": "darow-web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start-dev": "vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "preview": "vite preview",
        "test:unit": "vitest run",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
        "lint:eslint": "eslint . --fix --cache",
        "lint": "eslint . --ext .js,.vue",
        "lint:fix": "eslint . --ext .js,.vue --fix",
        "format": "prettier --write src/"
    },
    "dependencies": {
        "@lucide/vue": "1.24.0",
        "@myapplibs/web-platform": "github:MyAppLibs/web-platform#v0.3.0",
        "@tanstack/vue-table": "8.21.3",
        "@tiptap/extension-text-style": "^3.31.3",
        "@tiptap/starter-kit": "3.27.3",
        "@tiptap/vue-3": "^3.31.3",
        "@vueuse/core": "14.3.0",
        "echarts": "6.1.0",
        "maplibre-gl": "6.16.0",
        "mermaid": "12.2.0",
        "pdfmake": "0.3.12",
        "pinia": "^3.0.4",
        "swagger-ui-dist": "5.34.0",
        "vue": "3.5.44",
        "vue-i18n": "11.4.14",
        "vue-router": "5.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@intlify/eslint-plugin-vue-i18n": "4.5.1",
        "@tailwindcss/vite": "4.3.2",
        "@tsconfig/node24": "24.0.4",
        "@types/node": "24.12.4",
        "@types/pdfmake": "0.3.3",
        "@typescript-eslint/eslint-plugin": "8.72.1",
        "@typescript-eslint/parser": "8.72.1",
        "@vitejs/plugin-vue": "6.0.7",
        "@vue/test-utils": "^2.4.11",
        "@vue/tsconfig": "^0.9.1",
        "daisyui": "5.5.19",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-unused-imports": "^4.4.1",
        "eslint-plugin-vue": "^10.9.2",
        "globals": "^17.6.0",
        "jsdom": "^30.0.1",
        "npm-run-all2": "9.0.4",
        "prettier": "3.8.4",
        "tailwindcss": "4.3.2",
        "typescript": "6.0.3",
        "vite": "8.3.5",
        "vitest": "5.0.5",
        "vue-eslint-parser": "10.4.1",
        "vue-tsc": "3.3.7"
    },
    "overrides": {
        "glob": "14.0.2",
        "minimatch@7 - 11.0.0": "11.0.1"
    }
}
