{
    "swagger": "2.0",
    "info": {
        "description": "Serveur cartographique GeoAPI — sources, tables, rows, tuiles MVT, dérivation.",
        "title": "GeoAPI",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/sources": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sources"
                ],
                "summary": "List cached sources",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/service.Source"
                            }
                        }
                    }
                }
            }
        },
        "/sources/refresh": {
            "post": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sources"
                ],
                "summary": "Rescan workDir",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/service.Source"
                            }
                        }
                    }
                }
            }
        },
        "/sources/upload": {
            "post": {
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sources"
                ],
                "summary": "Upload a file and load it into a new table",
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/sources/{name}/load": {
            "post": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sources"
                ],
                "summary": "Load a source file into a new table",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Source file name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Layer name (required for multi-layer sources)",
                        "name": "layer",
                        "in": "query"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/tables": {
            "get": {
                "description": "Liste toutes les tables avec leurs métadonnées",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tables"
                ],
                "summary": "List tables",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/router.metadataDTO"
                            }
                        }
                    }
                }
            }
        },
        "/tables/{tableId}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tables"
                ],
                "summary": "Get table metadata",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Table ID",
                        "name": "tableId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/router.metadataDTO"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "description": "Supprime une table et ses données",
                "tags": [
                    "tables"
                ],
                "summary": "Delete a table",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Table ID",
                        "name": "tableId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/tables/{tableId}/bbox": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "geo"
                ],
                "summary": "Filter row pkeys by bounding box",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Table ID",
                        "name": "tableId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/tables/{tableId}/columns": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tables"
                ],
                "summary": "Add a column",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Table ID",
                        "name": "tableId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/tables/{tableId}/derive": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tables"
                ],
                "summary": "Derive a table from a SELECT query",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Source table ID",
                        "name": "tableId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/tables/{tableId}/export": {
            "get": {
                "produces": [
                    "application/json",
                    "text/csv"
                ],
                "tags": [
                    "tables"
                ],
                "summary": "Export a table",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Table ID",
                        "name": "tableId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "csv or geojson",
                        "name": "format",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/tables/{tableId}/geometry-types": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "geo"
                ],
                "summary": "List distinct geometry types present in a table",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Table ID",
                        "name": "tableId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/tables/{tableId}/rows": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "rows"
                ],
                "summary": "List rows",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Table ID",
                        "name": "tableId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Pagination offset",
                        "name": "offset",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Pagination limit",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "rows"
                ],
                "summary": "Add one or more rows",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Table ID",
                        "name": "tableId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/tables/{tableId}/rows/{pkey}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "rows"
                ],
                "summary": "Get a row by pkey",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Table ID",
                        "name": "tableId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Row primary key",
                        "name": "pkey",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "rows"
                ],
                "summary": "Delete a row",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Table ID",
                        "name": "tableId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Row primary key",
                        "name": "pkey",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            },
            "patch": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "rows"
                ],
                "summary": "Update a row",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Table ID",
                        "name": "tableId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Row primary key",
                        "name": "pkey",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/tables/{tableId}/schema": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tables"
                ],
                "summary": "Get table schema",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Table ID",
                        "name": "tableId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/tables/{tableId}/tiles/{z}/{x}/{y}": {
            "get": {
                "produces": [
                    "application/x-protobuf"
                ],
                "tags": [
                    "geo"
                ],
                "summary": "Get an MVT tile",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Table ID",
                        "name": "tableId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Zoom level",
                        "name": "z",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Tile X",
                        "name": "x",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Tile Y",
                        "name": "y",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "router.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "error": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "router.metadataDTO": {
            "type": "object",
            "properties": {
                "bbox": {
                    "type": "string"
                },
                "createdAt": {
                    "type": "string"
                },
                "geometryColumn": {
                    "type": "string"
                },
                "isGeo": {
                    "type": "boolean"
                },
                "physicalName": {
                    "type": "string"
                },
                "rowCount": {
                    "type": "integer"
                },
                "srid": {
                    "type": "integer"
                },
                "tableId": {
                    "type": "string"
                },
                "tableName": {
                    "type": "string"
                },
                "updatedAt": {
                    "type": "string"
                }
            }
        },
        "service.Source": {
            "type": "object",
            "properties": {
