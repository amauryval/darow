                },
                "tableId": {
                    "type": "string"
                }
            }
        },
        "service.SourceLayer": {
            "type": "object",
            "properties": {
                "loaded": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "tableId": {
                    "type": "string"
                }
            }
        }
    }
}